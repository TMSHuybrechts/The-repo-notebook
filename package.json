{
  "name": "github-repo-notebook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "bin": {
    "repo-notebook-mcp": "bin/repo-notebook-mcp.js"
  },
  "scripts": {
    "dev": "node server/index.js",
    "build": "vite build",
    "preview": "node server/index.js --production",
    "app": "npm run build && electron .",
    "app:build": "npm run build && electron-builder",
    "app:build:win": "npm run build && electron-builder --win",
    "app:build:mac": "npm run build && electron-builder --mac",
    "app:build:linux": "npm run build && electron-builder --linux",
    "mcp": "node mcp/server.js",
    "test": "node --test server/suggest.test.js test/graph-settings.test.js test/mcp-launcher.test.js test/search-saved-repos.test.js test/platform.test.js test/remote.test.js tests/i18n.test.mjs tests/i18n-api.test.mjs",
    "test:i18n": "node --test tests/i18n.test.mjs tests/i18n-api.test.mjs"
  },
  "build": {
    "appId": "com.thomashuybrechts.reponotebook",
    "productName": "Repo Notebook",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "server/**",
      "mcp/**",
      "shared/**",
      "electron/**",
      "public/**",
      "package.json"
    ],
    "asar": false,
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "darkModeSupport": true,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "contents": [
        { "x": 130, "y": 200 },
        { "x": 410, "y": 200, "type": "link", "path": "/Applications" }
      ]
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64", "arm64"] },
        { "target": "tar.gz", "arch": ["x64", "arm64"] }
      ],
      "icon": "build/icon.png",
      "category": "Development",
      "synopsis": "Save, clone, install and run GitHub repositories from one place",
      "executableName": "repo-notebook"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Repo Notebook"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@vitejs/plugin-react": "^4.3.4",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3"
  }
}
