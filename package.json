{
  "name": "github-repo-notebook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node server/index.js",
    "build": "vite build",
    "preview": "node server/index.js --production",
    "mcp": "node mcp/server.js",
    "app": "electron .",
    "app:build": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.thomashuybrechts.reponotebook",
    "productName": "Repo Notebook",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "server/**",
      "mcp/**",
      "electron/**",
      "public/**",
      "package.json"
    ],
    "asar": false,
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Repo Notebook",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@vitejs/plugin-react": "^4.3.4",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2"
  }
}
